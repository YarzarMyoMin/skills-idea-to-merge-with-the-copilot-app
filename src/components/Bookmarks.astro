---
const { title = "Mona's Bookmark Manager" } = Astro.props;
---
<section>
  <header>
    <h1>{title}</h1>
    <p class="tagline">Save and share tidy links — Mona-style.</p>
  </header>

  <form id="bookmark-form" on:submit>
    <div class="field">
      <label for="url">URL</label>
      <input id="url" name="url" type="text" inputmode="url" autocomplete="off" placeholder="example.com or https://example.com" required />
    </div>
    <button type="submit">Add Bookmark</button>
  </form>
  <p class="hint">Enter any URL (with or without protocol). Mona will normalise it and create a short mona- slug.</p>

  <div id="list-header">
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear" class="clear">Clear all</button>
  </div>

  <ul id="bookmarks-list">
    <li class="empty">No bookmarks yet — add one above.</li>
  </ul>

  <footer>Made with ♥ by Mona's Bookmark Manager</footer>

  <script type="module" client:load>
    import { normalizeUrl, generateSlug, parseStoredBookmarks, formatBookmark } from '/src/lib/bookmarks.js';

    const LS_KEY = 'mona-bookmarks';
    const form = document.getElementById('bookmark-form');
    const input = document.getElementById('url');
    const list = document.getElementById('bookmarks-list');
    const clearBtn = document.getElementById('clear');

    function safeSave(bookmarks) {
      try {
        localStorage.setItem(LS_KEY, JSON.stringify(bookmarks));
      } catch (e) {
        // Swallow storage errors — optionally could show a toast.
        console.error('Failed to save bookmarks', e);
      }
    }

    function render(bookmarks) {
      list.innerHTML = '';
      if (!bookmarks || bookmarks.length === 0) {
        const li = document.createElement('li');
        li.className = 'empty';
        li.textContent = 'No bookmarks yet — add one above.';
        list.appendChild(li);
        return;
      }
      for (const bm of bookmarks) {
        const li = document.createElement('li');
        li.className = 'bookmark';
        // exact visible separator requirement: render with " :: " between URL and slug
        const text = document.createElement('span');
        text.textContent = `${bm.url} :: ${bm.slug}`;
        text.className = 'url';
        li.appendChild(text);

        list.appendChild(li);
      }
    }

    // load
    let raw = null;
    try {
      raw = localStorage.getItem(LS_KEY);
    } catch (e) {
      // ignore
      raw = null;
    }
    let bookmarks = parseStoredBookmarks(raw);
    render(bookmarks);

    form.addEventListener('submit', (ev) => {
      ev.preventDefault(); // first thing — never fall back to native submit
      const v = input.value || '';
      const url = normalizeUrl(v);
      const slug = 'mona-' + generateSlug();
      bookmarks = [...bookmarks, { url, slug }];
      safeSave(bookmarks);
      render(bookmarks);
      input.value = '';
      input.focus();
    });

    clearBtn.addEventListener('click', () => {
      if (!confirm('Clear all bookmarks?')) return;
      bookmarks = [];
      safeSave(bookmarks);
      render(bookmarks);
    });
  </script>
</section>